name: pcdn 拒绝
desc: |-
    - https://www.v2ex.com/t/1127079
category: ruleset
icon: https://cdn.jsdelivr.net/gh/Koolson/Qure@master/IconSet/Color/Reject.png

rules:
    - DOMAIN,tp2p.kg.qq.com,REJECT
    - DOMAIN,twns.p2ptun.qq.com,REJECT
    - DOMAIN,sd-gl.xinqiucc.com,REJECT
    - DOMAIN,xyp-n.kuiniuca.com,REJECT
    - DOMAIN,sdk1xyajs.data.kuiniuca.com,REJECT
    - DOMAIN,ac.dun.163.com,REJECT
    - DOMAIN,fp-upload.dun.163.com,REJECT
    - DOMAIN-SUFFIX,v1d.szbdyd.com,REJECT
    - DOMAIN-SUFFIX,mcdn.bilivideo.cn,REJECT
    - RULE-SET,anti-AD.pcdn,REJECT,no-resolve
rule-providers:
    anti-AD.pcdn:
        behavior: domain
        format: txt
        interval: 86400
        type: http
        url: https://raw.githubusercontent.com/privacy-protection-tools/anti-AD/master/discretion/pcdn.txt
