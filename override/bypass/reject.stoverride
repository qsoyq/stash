name: 分流拒绝
desc: |-
category: ruleset
icon: https://cdn.jsdelivr.net/gh/Koolson/Qure@master/IconSet/Color/Reject.png

http:
    mitm:
        - api.bilibili.com
    url-rewrite:
        # 哔哩哔哩
        - https://api.bilibili.com/x/push/report - reject
        - https://api.bilibili.com/x/report/click/ios - reject
        - https://api.bilibili.com/x/report/heartbeat/mobile - reject
        - https://api.bilibili.com/x/v2/history/report - reject
        - https://api.bilibili.com/x/v2/history/report_list - reject

        # YouTube?
        - https://redirector.googlevideo.com/report_mapping - reject

rules:
    # 哔哩哔哩
    - AND,((DOMAIN,stun.chat.bilibili.com),(DST-PORT,3478)),REJECT
    - AND,((DOMAIN,stun6.chat.bilibili.com),(DST-PORT,3479)),REJECT

    - RULE-SET,domain.reject.drop,REJECT-DROP,no-resolve
    - RULE-SET,domain.reject,REJECT,no-resolve

rule-providers:
    domain.reject.drop:
        behavior: domain
        format: yaml
        interval: 86400
        type: http
        url: https://raw.githubusercontent.com/qsoyq/stash/main/ruleset/domain.reject.drop.yaml
    domain.reject:
        behavior: domain
        format: yaml
        interval: 86400
        type: http
        url: https://raw.githubusercontent.com/qsoyq/stash/main/ruleset/domain.reject.yaml
