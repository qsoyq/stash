name: 分流拒绝
desc: |-
category: ruleset
icon: https://cdn.jsdelivr.net/gh/Koolson/Qure@master/IconSet/Color/Reject.png

http:
    mitm:
        - api.bilibili.com
        - redirector.googlevideo.com
        - b.clarity.ms
        - www.google-analytics.com
        - analytics.google.com
        - stats.g.doubleclick.net
        - h.trace.qq.com
        # 喜大普奔
        - image.spdbccc.com

    url-rewrite:
        - https://api.bilibili.com/x/push/report - reject
        - https://api.bilibili.com/x/report/click/ios - reject
        - https://api.bilibili.com/x/report/heartbeat/mobile - reject
        - https://api.bilibili.com/x/v2/history/report - reject
        - https://api.bilibili.com/x/v2/history/report_list - reject

        - https://redirector.googlevideo.com/report_mapping - reject
        - https://www.google-analytics.com/\w+/collect - reject
        - https://analytics.google.com/\w+/collect - reject
        - https://stats.g.doubleclick.net/\w+/collect - reject

        - https://b.clarity.ms/collect - reject

        - https?://h.trace.qq.com/kv - reject

        # 喜大普奔
        - ^https?:\/\/image\.spdbccc\.com\.cn\/group\d\/M00\/[A-Z0-9]{2}\/[A-Z0-9]{2}\/.+(yg285|Qk562|Ac840|bM519|cE569|SQ969|0A304) - reject

rules:
    # 哔哩哔哩
    - AND,((DOMAIN,stun.chat.bilibili.com),(DST-PORT,3478)),REJECT,no-track
    - AND,((DOMAIN,stun6.chat.bilibili.com),(DST-PORT,3479)),REJECT,no-track
    - DOMAIN,www.google-analytics.com,REJECT,no-track
    - RULE-SET,domain.reject.drop,REJECT-DROP,no-resolve,no-track
    - RULE-SET,domain.reject,REJECT,no-resolve,no-track

rule-providers:
    domain.reject.drop:
        behavior: domain
        format: yaml
        interval: 86400
        type: http
        url: https://raw.githubusercontent.com/qsoyq/stash/main/ruleset/domain.reject.drop.yaml
    domain.reject:
        behavior: domain
        format: yaml
        interval: 86400
        type: http
        url: https://raw.githubusercontent.com/qsoyq/stash/main/ruleset/domain.reject.yaml
