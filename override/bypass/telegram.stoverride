name: 电报分流代理
desc: |-
    未设定的策略组默认使用 PROXY 代替
    分流策略组 -> Telegram
    分流策略组 -> TelegramDC1
    分流策略组 -> TelegramDC2
    分流策略组 -> TelegramDC3
    分流策略组 -> TelegramDC4
    分流策略组 -> TelegramDC5
category: ruleset
icon: https://raw.githubusercontent.com/qsoyq/icons/main/assets/icon/telegram.png
rules:
    - IP-CIDR,91.108.56.107/32,REJECT,no-resolve
    - IP-CIDR,95.161.76.100/31,REJECT,no-resolve
    - IP-CIDR,5.28.192.0/18,TelegramDC4,no-resolve
    - IP-ASN,59930,TelegramDC1,no-resolve
    - IP-ASN,44907,TelegramDC2,no-resolve
    - IP-ASN,211157,TelegramDC3,no-resolve
    - IP-ASN,62041,TelegramDC4,no-resolve
    - IP-ASN,62014,TelegramDC5,no-resolve
    - DOMAIN,pluto.web.telegram.org,TelegramDC1
    - DOMAIN,venus.web.telegram.org,TelegramDC2
    - DOMAIN,aurora.web.telegram.org,TelegramDC3
    - DOMAIN,vesta.web.telegram.org,TelegramDC4
    - DOMAIN,flora.web.telegram.org,TelegramDC5
    - DOMAIN-SUFFIX,iturrit.com,Telegram
    - DOMAIN-SUFFIX,telegram.tools,Telegram
    - geosite,telegram,Telegram
    - RULE-SET,ip.telegram,Telegram,no-resolve
rule-providers:
    ip.telegram:
        behavior: ipcidr
        format: yaml
        interval: 86400
        type: http
        url: https://raw.githubusercontent.com/qsoyq/stash/main/ruleset/ip.telegram.yaml
