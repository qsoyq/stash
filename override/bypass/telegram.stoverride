name: 电报分流代理
desc: |-
    分流策略组 -> Telegram
category: ruleset
icon: https://raw.githubusercontent.com/qsoyq/icons/main/assets/icon/telegram.png

rules:
    - DOMAIN-SUFFIX,iturrit.com,Telegram,no-track
    - RULE-SET,ip.telegram,Telegram,no-resolve,no-track
    - geosite,telegram,Telegram,no-track
    - IP-ASN,62041,Telegram,no-resolve,no-track # Telegram

rule-providers:
    ip.telegram:
        behavior: ipcidr
        format: yaml
        interval: 86400
        type: http
        url: https://raw.githubusercontent.com/qsoyq/stash/main/ruleset/ip.telegram.yaml
