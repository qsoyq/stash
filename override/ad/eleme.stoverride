        - https://waimai-guide.ele.me/gw/mtop.alsc.eleme.collection.homepagev2/1.0 response-jq .data.data.shop_list_recommend_magex3_tab.fields.items|=map(select(.bizCode!="banner"))
        - https://waimai-guide.ele.me/gw/mtop.alsc.eleme.collection.homepagev2/1.0 response-jq .data.data.shop_list_recommend_magex3_tab.fields.items|=map(select(.bizCode!="smart_cloud_search_trends_weex"))
        - https://waimai-guide.ele.me/gw/mtop.alsc.eleme.collection.homepagev2/1.0 response-jq .data.data.shop_list_recommend_magex3_tab.fields.items|=map(select(.bizCode!="experience_survey_v2"))
        - https://waimai-guide.ele.me/gw/mtop.alsc.eleme.collection.homepagev2/1.0 response-jq .data.data.shop_list_recommend_magex3_tab.fields.items|=map(select(.bizCode!="smart_cloud_theme_v3"))
        - https://waimai-guide.ele.me/gw/mtop.alsc.eleme.collection.homepagev2/1.0 response-jq .data.data.shop_list_recommend_magex3_tab.fields.items|=map(select(.bizCode!="smart_retail_platform_entrance"))
        - https://waimai-guide.ele.me/gw/mtop.alsc.eleme.homepagev1/1.0 response-jq .data.suspension_template=null
