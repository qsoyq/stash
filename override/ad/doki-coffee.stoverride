name: Doki 咖啡
desc: |-
    - 首页弹窗图片
icon: https://pic.51hchc.com/hq/b05fbacf-763d-4b81-84ad-759089d3396f.jpg
category: ad
http:
    mitm:
        - stat.51hchc.com
    force-http-engine:
        - stat.51hchc.com
    script:
        -   name: doki-coffee
            binary-mode: false
            match: https://stat.51hchc.com/app-config-new/
            max-size: 1048576
            require-body: true
            timeout: 20
            type: response
            debug: false
script-providers:
    doki-coffee:
        url: https://raw.githubusercontent.com/qsoyq/stash/main/script/ad/doki-coffee.js
        interval: 86400
