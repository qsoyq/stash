name: Telegram
desc: |-
    - apple-itunes-app
    - t.me
        - 顶部下载 App 按钮
        - 屏蔽网页自动唤醒 App
category: ad
icon: https://fastly.jsdelivr.net/gh/Koolson/Qure@master/IconSet/Color/Telegram.png
http:
    mitm:
        - t.me
    script:
        - name: telegram
          binary-mode: false
          match: https://t.me/
          max-size: 2097152
          require-body: true
          timeout: 10
          argument: ""
          type: response
          debug: false

script-providers:
    "telegram":
        url: https://raw.githubusercontent.com/qsoyq/stash/main/script/ad/telegram.js
        interval: 86400
