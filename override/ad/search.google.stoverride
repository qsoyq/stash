name: 谷歌搜索
desc: |-
    - 搜索结果页
        - 赞助商广告
        - 图片
        - 相关问题
        - 视频
        - 短视频
        - 用户还搜索了
        - 图书
        - 参演电视剧
category: ad
icon: https://raw.githubusercontent.com/qsoyq/icons/main/assets/icon/google.png
http:
    mitm:
        - www.google.com
    force-http-engine:
        - www.google.com
    header-rewrite:
        - https://www.google.com/ response-del content-security-policy
    script:
        -   match: ^https?://www.google.com/search\?q=.*$
            name: google-search-rewrite
            type: response
            require-body: true
            max-size: -1
            timeout: 5
            debug: true
script-providers:
    google-search-rewrite:
        url: https://raw.githubusercontent.com/qsoyq/stash/main/script/ad/google-search-rewrite.js
        interval: 86400
