name: nodeseek
desc: |-
    - 广告
    - 首页置顶轮播帖子
    - 快捷功能区
    - 所有板块
    - 用户数目｜欢迎新用户
    - 用户签名
    - 页脚
    - 外链自动重定向
    - 导航｜增加内版模块
    - 支持 NetNewsWire 访问头像
category: ad
icon: https://www.nodeseek.com/static/image/favicon/favicon-32x32.png
http:
    mitm:
        - www.nodeseek.com
    body-rewrite:
        - https://www.nodeseek.com/api/promotion/list response-jq .data=[]

    script:
        - name: nodeseek
          binary-mode: false
          match: https://www.nodeseek.com/avatar/
          max-size: 1048576
          require-body: true
          timeout: 20
          type: request
          debug: false

        - name: nodeseek
          binary-mode: false
          match: https://www.nodeseek.com/(post-.*|categories.*|$)
          max-size: 1048576
          require-body: true
          timeout: 20
          type: response
          debug: false

script-providers:
    nodeseek:
        url: https://raw.githubusercontent.com/qsoyq/stash/main/script/ad/nodeseek.js
        interval: 86400
