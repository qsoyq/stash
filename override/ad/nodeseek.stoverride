name: nodeseek
desc: |-
    - 广告
    - 首页置顶轮播帖子
    - 快捷功能区
    - 所有板块
    - 用户数目｜欢迎新用户
    - 用户签名
    - 页脚
    - 外链自动重定向
    - 导航｜保留全部，其余项目按自定义数组排序
    - 支持 NetNewsWire 访问头像
    - 移动端详情页手势翻页
        - 左滑跳转下一页
        - 右滑跳转上一页
    - 自动签到：已登录且当天未签到时，在首页、分类页和帖子页自动签到，可选鸡腿 x5 或试试手气
    - 可在覆写详情 → 参数中分别开关，NetNewsWire 头像修复和自动签到默认关闭，其余默认开启
    - 参数功能需要 Stash iOS/tvOS 3.7+ 或 macOS 4.4+（Beta）
category: ad
icon: https://www.nodeseek.com/static/image/favicon/favicon-32x32.png
arguments-version: 1
arguments:
    block_ads:
        type: switch
        title: 屏蔽推广广告
        description: 清空推广接口返回的广告列表
        default: true
    hide_carousel:
        type: switch
        title: 隐藏首页置顶轮播
        default: true
    hide_sidebar_panels:
        type: switch
        title: 隐藏侧栏面板
        description: 整体隐藏侧栏面板，包括所有板块、用户统计和欢迎新用户
        default: true
    hide_fast_nav:
        type: switch
        title: 隐藏快捷功能区
        default: true
    hide_signature:
        type: switch
        title: 隐藏用户签名
        default: true
    hide_footer:
        type: switch
        title: 隐藏页脚
        default: true
    direct_external_links:
        type: switch
        title: 外链直接跳转
        description: 将页面中的跳转链接替换为实际目标地址
        default: true
    show_inside_nav:
        type: switch
        title: 自定义导航栏
        description: 保留「全部」，其余项目按导航项目顺序显示；关闭后保留网站原导航
        default: true
    navigation_order:
        type: input
        title: 导航项目顺序
        description: 填写 JSON 数组，例如 ["日常","技术","情报","生活","内版"]；支持日常、技术、情报、测评、交易、拼车、推广、生活、Dev、贴图、曝光、无意义、沙盒及内版，未列出的项目隐藏，[] 表示仅保留全部
        default: '["日常","技术","情报","拼车","内版"]'
        max-length: 2048
    enable_swipe:
        type: switch
        title: 启用手势翻页
        description: 左滑超过 150px 跳到下一页，右滑超过 150px 跳到上一页
        default: true
    fix_nnw_avatar:
        type: switch
        title: 修复 NetNewsWire 头像访问
        description: 为 NetNewsWire 头像请求替换 User-Agent
        default: false
    auto_checkin:
        type: select
        title: 自动签到
        description: 已登录且当天未签到时，访问首页、分类页或帖子页会自动签到；关闭时不注入任何签到代码
        default: 'off'
        options:
            -   value: 'off'
                label: 关闭
            -   value: fixed
                label: 鸡腿 x5
            -   value: random
                label: 试试手气
http:
    mitm:
        - www.nodeseek.com
    force-http-engine:
        - www.nodeseek.com
    body-rewrite:
        - https://www.nodeseek.com/api/promotion/list response-jq if ${args.block_ads|json} then .data=[] else . end
    script:
        -   name: nodeseek
            binary-mode: false
            match: https://www.nodeseek.com/avatar/
            max-size: 1048576
            require-body: true
            timeout: 20
            type: request
            debug: false
            argument: '{"fix_nnw_avatar":${args.fix_nnw_avatar|json}}'
        -   name: nodeseek
            binary-mode: false
            match: https://www.nodeseek.com/(post-.*|categories.*|space.*|$)
            max-size: 1048576
            require-body: true
            timeout: 20
            type: response
            debug: false
            argument: '{"hide_carousel":${args.hide_carousel|json},"hide_sidebar_panels":${args.hide_sidebar_panels|json},"hide_fast_nav":${args.hide_fast_nav|json},"hide_signature":${args.hide_signature|json},"hide_footer":${args.hide_footer|json},"direct_external_links":${args.direct_external_links|json},"show_inside_nav":${args.show_inside_nav|json},"navigation_order":${args.navigation_order|json},"enable_swipe":${args.enable_swipe|json},"auto_checkin":${args.auto_checkin|json}}'
script-providers:
    nodeseek:
        url: https://raw.githubusercontent.com/qsoyq/stash/analyze-nodeseek-checkin-override/script/ad/nodeseek.js
        interval: 86400
