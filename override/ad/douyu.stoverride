name: 斗鱼
desc: |-
    - 开屏广告
    - 开屏应用推荐广告
    - 直播间应用推荐
    - 直播间悬挂活动
    - 直播间热议插入广告
category: ad
icon: https://raw.githubusercontent.com/qsoyq/icons/main/assets/icon/douyu.png
http:
    mitm:
        - capi.douyucdn.cn
        - rtbapi.douyucdn.cn
        - apiv2.douyucdn.cn
        - apiv3.douyucdn.cn
    force-http-engine:
        - capi.douyucdn.cn
        - rtbapi.douyucdn.cn
        - apiv2.douyucdn.cn
        - apiv3.douyucdn.cn
    url-rewrite:
        - https://capi.douyucdn.cn/api/v1/getStartSend - reject
    body-rewrite:
        - https://rtbapi.douyucdn.cn/japi/dyadx/gateway/app/getinfo response-jq .data={}
        - https://apiv2.douyucdn.cn/japi/entrance/roomRes/nc/m/list response-jq .data.pendant_a=[]
        - https://apiv3.douyucdn.cn/mgapi/yubanc/api/room/heated/list response-jq .data.list|=map(select(.ad==null))
        - https://rtbapi.douyucdn.cn/japi/sign/app/getinfo response-jq .data=[]
