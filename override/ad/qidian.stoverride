name: 起点读书
desc: "- 启动页｜广告\n- 首页｜上方好评弹窗\n- 首页｜上方养书提醒弹窗\n- 首页｜推书弹窗\n- 首页｜右下角活动浮窗 | \n- 首页｜消息推送 | 夜冭殇支持《二手穿越：大耳贼刘备》白银宝箱,成为本作品的白银大盟\n- 阅读页｜新闻 | 书友xxxx成为了本作品长老\n- 阅读页｜上方工具栏通知弹窗｜上月订阅满1000点，获得3张月票\n- 阅读页｜追更排名前 100 提示\n- 移动端h5\n    - 打开起点读书 App/继续浏览 弹窗\n    - 底部下载 App 按钮\n    - 页脚"
category: ad
icon: https://raw.githubusercontent.com/qsoyq/icons/main/assets/icon/qidian.png
http:
    mitm:
        - magev6.if.qidian.com
        - m.qidian.com
    force-http-engine:
        - m.qidian.com
        - magev6.if.qidian.com
    body-rewrite:
        - https://magev6.if.qidian.com/argus/api/v4/client/getsplashscreen response-jq .Data.List=[]
        - https://magev6.if.qidian.com/argus/api/v1/message/getPopup response-jq .Data={}
        - https://magev6.if.qidian.com/argus/api/v1/maintain/playstrip response-jq .Data={}
        - https://magev6.if.qidian.com/argus/api/v1/client/getconf response-jq .Data.ActivityPopup={}
        - https://magev6.if.qidian.com/argus/api/v1/client/getconf response-jq .Data.ActivityIcon={}
        - https://magev6.if.qidian.com/argus/api/v1/bookshelf/getHoverAdv response-jq .Data.ItemList=[]
        - https://magev6.if.qidian.com/argus/api/v1/assembly/toolbar response-jq .Data.Getbooknews={}
        - https://magev6.if.qidian.com/argus/api/v1/message/getpushedmessagelist response-jq .Data.MsgList=[]
        - https://magev6.if.qidian.com/argus/api/v1/assembly/toolbar response-jq .Data.Getfrontactivity={}
        - https://magev6.if.qidian.com/argus/api/v1/bookLastPage/chaseChapterUpdate response-jq .Data.ChaseChapterUpdateRank=-1
    script:
        -   name: qidian
            binary-mode: false
            match: https://m.qidian.com
            max-size: 2097152
            require-body: true
            timeout: 10
            argument: ''
            type: response
            debug: false
script-providers:
    qidian:
        url: https://raw.githubusercontent.com/qsoyq/stash/main/script/ad/qidian.js
        interval: 86400
